{
  "module": "job_scam",
  "version": "v3",
  "best_algorithm": "SGDClassifier_Balanced",
  "selected_threshold": 0.65,
  "label_mapping": {
    "0": "legitimate",
    "1": "fraudulent"
  },
  "features": [
    "title",
    "location",
    "department",
    "salary_range",
    "company_profile",
    "description",
    "requirements",
    "benefits",
    "employment_type",
    "required_experience",
    "required_education",
    "industry",
    "function"
  ],
  "vectorizer": "TF-IDF (max_features=40000, ngram=(1,2), sublinear_tf=True)",
  "random_seed": 42
}